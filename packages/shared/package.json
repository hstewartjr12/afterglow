{
  "name": "@afterglow/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./recommend": {
      "types": "./src/recommend.ts",
      "default": "./src/recommend.ts"
    },
    "./candidates": {
      "types": "./src/candidates.ts",
      "default": "./src/candidates.ts"
    },
    "./spoilers": {
      "types": "./src/spoilers.ts",
      "default": "./src/spoilers.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
